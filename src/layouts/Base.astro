---
import '../styles/global.css'

const { title, description = 'A chat language model written in assembly and trained on one gaming GPU.' } = Astro.props
const full = title ? `${title}, Mnemonic` : 'Mnemonic, a chat model written in assembly'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Supergoatscriptguy" />
    <script is:inline>
      // before the first paint, so a remembered theme doesn't flash
      try {
        const t = localStorage.getItem('theme')
        if (t) document.documentElement.dataset.theme = t
      } catch {}
    </script>
  </head>
  <body>
    <header class="site page">
      <a class="name" href="/">Mnemonic</a>
      <a href="/#chapters">Chapters</a>
      <a href="https://github.com/Supergoatscriptguy/Mnemonic">GitHub</a>
      <a href="https://huggingface.co/SuperGoatScriptGuy/Mnemonic">Hugging Face</a>
      <a href="https://ollama.com/supergoatscriptguy/mnemonic">Ollama</a>
    </header>
    <main class="page">
      <slot />
    </main>
    <div class="page">
      <footer class="site">
        Made by Supergoatscriptguy. The source is on <a href="https://github.com/Supergoatscriptguy/Mnemonic">GitHub</a>.
        The page follows your system's light or dark setting, or you can <button class="theme" type="button" id="theme">switch it</button>.
      </footer>
    </div>
    <script is:inline>
      document.getElementById('theme').addEventListener('click', () => {
        const root = document.documentElement
        const dark = root.dataset.theme
          ? root.dataset.theme === 'dark'
          : matchMedia('(prefers-color-scheme: dark)').matches
        root.dataset.theme = dark ? 'light' : 'dark'
        try { localStorage.setItem('theme', root.dataset.theme) } catch {}
      })
    </script>
  </body>
</html>
