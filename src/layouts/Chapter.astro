---
import Base from './Base.astro'
import { existsSync } from 'node:fs'
import { chapters } from '../data/chapters.js'

const { frontmatter } = Astro.props
// only chapters that are written get links (the pages import this layout, so no glob here)
const written = c => existsSync(`src/pages/${c.slug}.mdx`)
const i = chapters.findIndex(c => c.slug === frontmatter.slug)
const prev = chapters[i - 1]
const next = chapters[i + 1]
---
<Base title={frontmatter.title} description={frontmatter.lead}>
  <article class="prose">
    <h1>{frontmatter.title}</h1>
    <slot />
    <p class="pager">
      {prev && <>The previous chapter is {written(prev) ? <a href={`/${prev.slug}`}>{prev.title}</a> : `${prev.title} [TODO]`}. </>}
      {next && <>Next comes {written(next) ? <a href={`/${next.slug}`}>{next.title}</a> : `${next.title} [TODO]`}.</>}
      {!next && <>That's the last chapter. <a href="/">Back to the start</a>.</>}
    </p>
  </article>
</Base>

<style>
  .pager {
    margin-top: 4rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule);
    color: var(--muted);
  }
</style>
