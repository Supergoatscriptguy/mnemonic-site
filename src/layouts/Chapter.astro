---
import Base from './Base.astro'
import { chapters } from '../data/chapters.js'

const { frontmatter } = Astro.props
const i = chapters.findIndex(c => c.num === frontmatter.num)
const prev = chapters[i - 1]
const next = chapters[i + 1]
---
<Base title={frontmatter.title} description={frontmatter.lead}>
  <article class="wrap chapter">
    <div class="prose">
      <p class="label">Chapter {frontmatter.num} of {chapters.length - 1}</p>
      <h1>{frontmatter.title}</h1>
      <p class="lead">{frontmatter.lead}</p>
      <hr />
      <slot />
    </div>
    <nav class="pager prose">
      {prev ? <a href={`/${prev.slug}`}><span class="label">Previous</span>{prev.num}. {prev.title}</a> : <span />}
      {next && <a class="next" href={`/${next.slug}`}><span class="label">Next</span>{next.num}. {next.title}</a>}
    </nav>
  </article>
</Base>

<style>
  .chapter h1 {
    margin: 10px 0 18px;
  }
  .chapter hr {
    margin: 36px 0 32px;
  }
  .pager {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--rule);
  }
  .pager a {
    display: flex;
    flex-direction: column;
    gap: 4px;
    color: var(--text);
    font-weight: 550;
  }
  .pager a:hover {
    text-decoration: none;
    color: var(--accent);
  }
  .pager .next {
    text-align: right;
    margin-left: auto;
  }
</style>
